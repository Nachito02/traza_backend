erDiagram

%% =========================
%% ORIGEN (BASE ESTRUCTURAL)
%% =========================
PRODUCTOR {
  uuid productor_id PK
  text razon_social
}

BODEGA {
  uuid bodega_id PK
  text nombre
  text razon_social
  text cuit
}

FINCA {
  uuid finca_id PK
  uuid productor_id FK
  text nombre_finca
}

CUARTEL {
  uuid cuartel_id PK
  uuid finca_id FK
  text codigo_cuartel
  float superficie_ha
  text cultivo
  text variedad
}

CAMPANIA {
  uuid campania_id PK
  date fecha_inicio
  date fecha_fin
}


PRODUCTOR ||--o{ BODEGA : administra
BODEGA ||--o{ FINCA : posee
FINCA ||--o{ CUARTEL : divide
CUARTEL ||--o{ CAMPANIA : se_usa_en

%% =========================
%% PROTOCOLOS (PLANTILLAS)
%% =========================
PROTOCOLO {
  uuid protocolo_id PK
  text nombre
  text version
}

PROTOCOLO_ETAPA {
  uuid etapa_id PK
  uuid protocolo_id FK
  text nombre
  int orden
}

PROTOCOLO_PROCESO {
  uuid proceso_id PK
  uuid etapa_id FK
  text nombre
  text evento_tipo
  bool obligatorio
  int orden
}

PROTOCOLO ||--o{ PROTOCOLO_ETAPA : define
PROTOCOLO_ETAPA ||--o{ PROTOCOLO_PROCESO : contiene

%% =========================
%% TRAZABILIDAD (INSTANCIA)
%% =========================
TRAZABILIDAD {
  uuid trazabilidad_id PK
  uuid protocolo_id FK
  uuid productor_id FK
  uuid finca_id FK
  uuid cuartel_id FK
  uuid campania_id FK
  text estado
}

PROTOCOLO ||--o{ TRAZABILIDAD : instancia
CUARTEL ||--o{ TRAZABILIDAD : ancla
CAMPANIA ||--o{ TRAZABILIDAD : contextualiza

%% =========================
%% MILESTONES (UX / TIMELINE)
%% =========================
MILESTONE {
  uuid milestone_id PK
  uuid trazabilidad_id FK
  uuid proceso_id FK
  text estado
  timestamp created_at
}

TRAZABILIDAD ||--o{ MILESTONE : contiene
PROTOCOLO_PROCESO ||--o{ MILESTONE : instancia

%% =========================
%% EVENTOS (VERDAD TÉCNICA)
%% =========================
EVENTO_RIEGO {
  uuid evento_riego_id PK
  date fecha
  float volumen
  text unidad
}

EVENTO_CANOPIA {
  uuid evento_canopia_id PK
  date fecha
  text tipo_practica
}

EVENTO_APLICACION_FITO {
  uuid evento_fito_id PK
  date fecha
  float dosis
  int carencia_dias
}

EVENTO_COSECHA {
  uuid lote_cosecha_id PK
  date fecha_cosecha
  float cantidad
  text unidad
}

CUARTEL ||--o{ EVENTO_RIEGO : registra
CUARTEL ||--o{ EVENTO_CANOPIA : registra
CUARTEL ||--o{ EVENTO_APLICACION_FITO : registra
CUARTEL ||--o{ EVENTO_COSECHA : genera

%% =========================
%% MILESTONE → EVENTO
%% =========================
MILESTONE_EVENTO {
  uuid milestone_evento_id PK
  uuid milestone_id FK
  text evento_tabla
  uuid evento_id
}

MILESTONE ||--|| MILESTONE_EVENTO : vincula

%% =========================
%% EVIDENCIAS Y VALIDACIONES
%% =========================
EVIDENCIA {
  uuid evidencia_id PK
  uuid milestone_id FK
  text tipo
  text url
}

VALIDACION_MILESTONE {
  uuid validacion_id PK
  uuid milestone_id FK
  bool validado
  text validado_por
}

MILESTONE ||--o{ EVIDENCIA : adjunta
MILESTONE ||--o{ VALIDACION_MILESTONE : valida
