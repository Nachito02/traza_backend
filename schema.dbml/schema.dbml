  evento_fingerprint_id String [pk]
  tipo_evento String [not null]
  hash_contenido String [unique, not null]
  evento_tabla String [not null]
  evento_id String [not null]
  fecha DateTime [not null]
  cuartel_id String
  finca_id String
  created_at DateTime [default: `now()`, not null]
}

Table user_bodega {
  user_id String [not null]
  bodega_id String [not null]
  bodega bodega [not null]
  app_user app_user [not null]
  user_bodega_rol user_bodega_rol [not null]

  indexes {
    (user_id, bodega_id) [pk]
  }
}

Table user_bodega_rol {
  user_id String [not null]
  bodega_id String [not null]
  rol String [not null]
  user_bodega user_bodega [not null]

  indexes {
    (user_id, bodega_id, rol) [pk]
  }
}

Table user_rol {
  user_id String [not null]
  rol_id String [not null]
  rol rol [not null]
  app_user app_user [not null]

  indexes {
    (user_id, rol_id) [pk]
  }
}

Table encargo {
  encargo_id String [pk]
  bodega_id String [not null]
  finca_id String
  cuartel_id String
  milestone_id String
  created_by String [not null]
  titulo String [not null]
  descripcion String
  fecha_objetivo DateTime
  prioridad String [not null, default: 'media']
  estado EncargoEstado [not null, default: 'pendiente']
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [default: `now()`, not null]
  bodega bodega [not null]
  finca finca
  cuartel cuartel
  milestone milestone
  app_user app_user [not null]
  encargo_asignacion encargo_asignacion [not null]
  milestone_asignacion milestone_asignacion [not null]
}

Table encargo_asignacion {
  encargo_asignacion_id String [pk]
  encargo_id String [not null]
  user_id String [not null]
  estado EncargoAsignacionEstado [not null, default: 'pendiente']
  assigned_at DateTime [default: `now()`, not null]
  updated_at DateTime [default: `now()`, not null]
  completed_at DateTime
  whatsapp_contactado_at DateTime
  ultima_interaccion_bot_at DateTime
  observaciones String
  encargo encargo [not null]
  app_user app_user [not null]
  bot_action_log bot_action_log [not null]

  indexes {
    (encargo_id, user_id) [unique]
  }
}

Table trazabilidad_origen {
  trazabilidad_id String [not null]
  finca_id String [not null]
  cuartel_id String [not null]
  estado String [not null, default: 'habilitada']
  created_at DateTime [default: `now()`, not null]
  trazabilidad trazabilidad [not null]
  finca finca [not null]
  cuartel cuartel [not null]

  indexes {
    (trazabilidad_id, finca_id, cuartel_id) [pk]
  }
}

Table milestone_asignacion {
  milestone_id String [not null]
  finca_id String [not null]
  cuartel_id String [not null]
  operario_user_id String [not null]
  asignado_por_user_id String [not null]
  estado String [not null, default: 'pendiente']
  encargo_id String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [default: `now()`, not null]
  milestone milestone [not null]
  finca finca [not null]
  cuartel cuartel [not null]
  operario app_user [not null]
  asignado_por app_user [not null]
  encargo encargo

  indexes {
    (milestone_id, operario_user_id) [pk]
  }
}

Table bot_delegation {
  bot_delegation_id String [pk]
  granted_by_user_id String [not null]
  bot_user_id String [not null]
  bodega_id String
  scopes String[] [not null]
  activo Boolean [not null, default: true]
  expires_at DateTime
  revoked_at DateTime
  created_at DateTime [default: `now()`, not null]
  granted_by_user app_user [not null]
  bot_user app_user [not null]
  bodega bodega
  bot_action_log bot_action_log [not null]
}

Table bot_action_log {
  bot_action_log_id String [pk]
  bot_user_id String [not null]
  on_behalf_user_id String [not null]
  bot_delegation_id String
  encargo_asignacion_id String
  action String [not null]
  input_payload Json [not null, default: '{}']
  output_payload Json [not null, default: '{}']
  created_at DateTime [default: `now()`, not null]
  bot_user app_user [not null]
  on_behalf_user app_user [not null]
  bot_delegation bot_delegation
  encargo_asignacion encargo_asignacion
}

Table validacion_milestone {
  validacion_id String [pk]
  milestone_id String [not null]
  validado Boolean [not null]
  observacion String
  validado_por ValidadoPorTipo [not null, default: 'sistema']
  created_at DateTime [default: `now()`, not null]
  milestone milestone [not null]
}

Enum EvidenciaTipo {
  imagen
  pdf
  planilla
  otro
}

Enum MilestoneEstado {
  pendiente
  completado
  validado
  rechazado
}

Enum TrazabilidadEstado {
  draft
  en_curso
  finalizada
  certificada
}

Enum ValidadoPorTipo {
  sistema
  ia
  tecnico
}

Enum SeveridadRegla {
  bloqueo
  alerta
  info
}

Enum EstadoHallazgo {
  abierto
  en_proceso
  resuelto
  aceptado
  anulado
}

Enum EncargoEstado {
  pendiente
  en_progreso
  completado
  cancelado
}

Enum EncargoAsignacionEstado {
  pendiente
  en_progreso
  completado
  cancelado
}

