model BotActionLog {
  bot_action_log_id     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bot_user_id           String             @db.Uuid
  on_behalf_user_id     String             @db.Uuid
  bot_delegation_id     String?            @db.Uuid
  tarea_asignacion_id   String?            @db.Uuid
  action                String
  input_payload         Json               @default("{}")
  output_payload        Json               @default("{}")
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  bot_user              AppUser            @relation("BotActionActor", fields: [bot_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  on_behalf_user        AppUser            @relation("BotActionOnBehalf", fields: [on_behalf_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  bot_delegation        BotDelegation?     @relation(fields: [bot_delegation_id], references: [bot_delegation_id], onDelete: SetNull, onUpdate: NoAction)
  tarea_asignacion      TareaAsignacion?   @relation(fields: [tarea_asignacion_id], references: [tarea_asignacion_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([bot_user_id, created_at], map: "idx_bot_action_actor_date")
  @@index([on_behalf_user_id, created_at], map: "idx_bot_action_on_behalf_date")
  @@index([tarea_asignacion_id], map: "idx_bot_action_tarea_asignacion")
  @@map("bot_action_log")
}

model ValidacionMilestone {
  validacion_id String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestone_id  String          @db.Uuid
  validado      Boolean
  observacion   String?
  validado_por  ValidadoPorTipo @default(sistema)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  milestone     Milestone       @relation(fields: [milestone_id], references: [milestone_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([milestone_id], map: "idx_validacion_milestone")
  @@map("validacion_milestone")
}

enum EvidenciaTipo {
  imagen
  pdf
  planilla
  otro
}

enum MilestoneEstado {
  pendiente
  completado
  validado
  rechazado
}

enum TrazabilidadEstado {
  draft
  en_curso
  finalizada
  certificada
}

enum ValidadoPorTipo {
  sistema
  ia
  tecnico
}

enum SeveridadRegla {
  bloqueo
  alerta
  info
}

enum EstadoHallazgo {
  abierto
  en_proceso
  resuelto
  aceptado
  anulado
}

enum TareaEstado {
  pendiente
  en_progreso
  completado
  cancelado
}

enum TareaAsignacionEstado {
  pendiente
  en_progreso
  completado
  cancelado
}

enum TipoOperacionVasija {
  ingreso
  fermentacion
  trasiego
  descube
  correccion
  corte_parcial
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../erDiagram.svg"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "../schema.dbml"
}
