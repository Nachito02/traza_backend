generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  user_id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                      String
  email                       String?             @unique
  whatsapp_e164               String?             @unique
  whatsapp_verified_at        DateTime?           @db.Timestamptz(6)
  whatsapp_opt_in_at          DateTime?           @db.Timestamptz(6)
  created_at                  DateTime            @default(now()) @db.Timestamptz(6)
  password_hash               String?
  is_active                   Boolean             @default(true)
  refresh_token               RefreshToken[]
  user_bodega                 UserBodega[]
  user_rol                    UserRol[]
  encargos_creados            Encargo[]           @relation("EncargoCreatedBy")
  encargos_asignados          EncargoAsignacion[]
  bot_delegaciones_otorgadas  BotDelegation[]     @relation("BotDelegationGrantor")
  bot_delegaciones_recibidas  BotDelegation[]     @relation("BotDelegationBot")
  bot_action_logs_as_actor    BotActionLog[]      @relation("BotActionActor")
  bot_action_logs_on_behalf   BotActionLog[]      @relation("BotActionOnBehalf")
  @@map("app_user")
}

model Bodega {
  bodega_id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productor_id              String?                     @db.Uuid
  nombre                    String
  razon_social              String?
  cuit                      String?
  activo                    Boolean                     @default(true)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  productor                 Productor?                  @relation(fields: [productor_id], references: [productor_id], onDelete: Restrict, onUpdate: NoAction)
  evento_accidente          EventoAccidente[]
  evento_capacitacion       EventoCapacitacion[]
  evento_entrega_epp        EventoEntregaEpp[]
  evento_limpieza_cosecha   EventoLimpiezaCosecha[]
  evento_mantenimiento      EventoMantenimiento[]
  evento_no_conforme        EventoNoConforme[]
  evento_reclamo            EventoReclamo[]
  evento_residuo            EventoResiduo[]
  evento_sanitizacion_banos EventoSanitizacionBanos[]
  evento_sobrante_lavado    EventoSobranteLavado[]
  finca                     Finca[]
  campania                  Campania[]
  persona                   Persona[]
  productor_bodega          ProductorBodega[]
  trazabilidad              Trazabilidad[]
  user_bodega               UserBodega[]
  encargo                   Encargo[]
  bot_delegation            BotDelegation[]

  @@index([productor_id], map: "idx_bodega_productor")
  @@map("bodega")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Campania {
  campania_id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bodega_id                       String                            @db.Uuid
  nombre                          String
  fecha_inicio                    DateTime                          @db.Date
  fecha_fin                       DateTime                          @db.Date
  estado                          String                            @default("abierta")
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  bodega                          Bodega                            @relation(fields: [bodega_id], references: [bodega_id], onUpdate: NoAction)
  cuartel_campania                CuartelCampania[]
  evento_analisis_suelo           EventoAnalisisDeSuelo[]
  evento_aplicacion_fitosanitaria EventoAplicacionFitosanitaria[]
  evento_canopia                  EventoCanopia[]
  evento_cosecha                  EventoCosecha[]
  evento_energia                  EventoEnergia[]
  evento_fenologia                EventoFenologia[]
  evento_fertilizacion            EventoFertilizacion[]
  evento_labor_suelo              EventoLaborSuelo[]
  evento_monitoreo_enfermedad     EventoMonitoreoEnfermedad[]
  evento_monitoreo_plaga          EventoMonitoreoPlaga[]
  evento_precipitacion            EventoPrecipitacion[]
  evento_riego                    EventoRiego[]
  trazabilidad                    Trazabilidad[]
  @@unique([bodega_id, nombre], map: "uq_campania_bodega_nombre")
  @@index([bodega_id], map: "idx_campania_bodega")
  @@map("campania")
}

model CapacitacionAsistente {
  evento_capacitacion_id String              @db.Uuid
  persona_id             String              @db.Uuid
  evento_capacitacion    EventoCapacitacion @relation(fields: [evento_capacitacion_id], references: [evento_capacitacion_id], onDelete: Cascade, onUpdate: NoAction)
  persona                Persona             @relation(fields: [persona_id], references: [persona_id], onUpdate: NoAction)

  @@id([evento_capacitacion_id, persona_id])
  @@map("capacitacion_asistente")
}

model Cuartel {
  cuartel_id                      String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  finca_id                        String                            @db.Uuid
  codigo_cuartel                  String
  superficie_ha                   Decimal?                          @db.Decimal(10, 2)
  cultivo                         String?
  variedad                        String?
  sistema_productivo              String?
  sistema_conduccion              String?
  activo                          Boolean                           @default(true)
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  finca                           Finca                             @relation(fields: [finca_id], references: [finca_id], onUpdate: NoAction)
  cuartel_campania                CuartelCampania[]
  evento_analisis_suelo           EventoAnalisisDeSuelo[]
  evento_aplicacion_fitosanitaria EventoAplicacionFitosanitaria[]
  evento_canopia                  EventoCanopia[]
  evento_cosecha                  EventoCosecha[]
  evento_energia                  EventoEnergia[]
  evento_fenologia                EventoFenologia[]
  evento_fertilizacion            EventoFertilizacion[]
  evento_labor_suelo              EventoLaborSuelo[]
  evento_monitoreo_enfermedad     EventoMonitoreoEnfermedad[]
  evento_monitoreo_plaga          EventoMonitoreoPlaga[]
  evento_riego                    EventoRiego[]
  trazabilidad                    Trazabilidad[]

  @@unique([finca_id, codigo_cuartel])
  @@index([finca_id], map: "idx_cuartel_finca")
  @@map("cuartel")
}

model CuartelCampania {
  cuartel_id  String   @db.Uuid
  campania_id String   @db.Uuid
  estado      String   @default("habilitada")
  campania    Campania @relation(fields: [campania_id], references: [campania_id], onUpdate: NoAction)
  cuartel     Cuartel  @relation(fields: [cuartel_id], references: [cuartel_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([cuartel_id, campania_id])
  @@map("cuartel_campania")
}

model EventoAccidente {
  evento_accidente_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
