model BotDelegation {
  bot_delegation_id    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  granted_by_user_id   String         @db.Uuid
  bot_user_id          String         @db.Uuid
  bodega_id            String?        @db.Uuid
  scopes               String[]
  activo               Boolean        @default(true)
  expires_at           DateTime?      @db.Timestamptz(6)
