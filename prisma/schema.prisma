generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  user_id                             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                              String
  email                               String?               @unique
  whatsapp_e164                       String?               @unique
  whatsapp_verified_at                DateTime?             @db.Timestamptz(6)
  whatsapp_opt_in_at                  DateTime?             @db.Timestamptz(6)
  created_at                          DateTime              @default(now()) @db.Timestamptz(6)
  password_hash                       String?
  must_change_password                Boolean               @default(false)
  is_active                           Boolean               @default(true)
  refresh_token                       RefreshToken[]
  user_bodega                         UserBodega[]
  user_rol                            UserRol[]
  tareas_creadas                      Tarea[]               @relation("TareaCreatedBy")
  tareas_asignadas                    TareaAsignacion[]
  tarea_entradas                      TareaEntrada[]        @relation("TareaEntradaCreatedBy")
  bot_delegaciones_otorgadas          BotDelegation[]       @relation("BotDelegationGrantor")
  bot_delegaciones_recibidas          BotDelegation[]       @relation("BotDelegationBot")
  bot_action_logs_as_actor            BotActionLog[]        @relation("BotActionActor")
  bot_action_logs_on_behalf           BotActionLog[]        @relation("BotActionOnBehalf")
  milestone_asignaciones_as_operario  MilestoneAsignacion[] @relation("MilestoneAsignacionOperario")
  milestone_asignaciones_as_asignador MilestoneAsignacion[] @relation("MilestoneAsignacionAsignador")
  ordenes_enologo_creadas             OrdenEnologo[]        @relation("OrdenEnologoCreador")
  evento_aplicacion_fitosanitaria     EventoAplicacionFitosanitaria[]
  evento_canopia                      EventoCanopia[]
  evento_capacitacion                 EventoCapacitacion[]
  evento_cosecha                      EventoCosecha[]
  evento_entrega_epp                  EventoEntregaEpp[]
  evento_fenologia                    EventoFenologia[]
  evento_fertilizacion                EventoFertilizacion[]
  evento_labor_suelo                  EventoLaborSuelo[]
  evento_limpieza_cosecha             EventoLimpiezaCosecha[]
  evento_mantenimiento                EventoMantenimiento[]
  evento_monitoreo_enfermedad         EventoMonitoreoEnfermedad[]
  evento_monitoreo_plaga              EventoMonitoreoPlaga[]
  evento_no_conforme                  EventoNoConforme[]
  evento_reclamo                      EventoReclamo[]
  evento_residuo                      EventoResiduo[]
  evento_riego                        EventoRiego[]
  evento_sanitizacion_banos           EventoSanitizacionBanos[]
  evento_sobrante_lavado              EventoSobranteLavado[]
  evento_enmienda                     EventoEnmienda[]
  evento_cobertura_erosion            EventoCoberturaErosion[]
  evento_accidente                    EventoAccidente[]
  capacitacion_asistente              CapacitacionAsistente[]
  operaciones_vasija                  OperacionVasija[]
  cortes_responsable                  Corte[]               @relation("CorteResponsable")

  @@map("app_user")
}

model Bodega {
  bodega_id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productor_id              String?                   @db.Uuid
  nombre                    String
  razon_social              String?
  cuit                      String?
  activo                    Boolean                   @default(true)
  created_at                DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                  @default(now()) @db.Timestamptz(6)
  productor                 Productor?                @relation(fields: [productor_id], references: [productor_id], onDelete: Restrict, onUpdate: NoAction)
  evento_accidente          EventoAccidente[]
  evento_capacitacion       EventoCapacitacion[]
  evento_entrega_epp        EventoEntregaEpp[]
  evento_limpieza_cosecha   EventoLimpiezaCosecha[]
  evento_mantenimiento      EventoMantenimiento[]
  evento_no_conforme        EventoNoConforme[]
  evento_reclamo            EventoReclamo[]
  evento_residuo            EventoResiduo[]
  evento_sanitizacion_banos EventoSanitizacionBanos[]
  evento_sobrante_lavado    EventoSobranteLavado[]
  finca                     Finca[]
  campania                  Campania[]
  trazabilidad              Trazabilidad[]
  user_bodega               UserBodega[]
  tarea                     Tarea[]
  bot_delegation            BotDelegation[]
  remito_uva                RemitoUva[]
  ciu                       Ciu[]
  orden_enologo             OrdenEnologo[]
  vasija                    Vasija[]
  qc_ingreso_uva            QcIngresoUva[]
  operacion_vasija          OperacionVasija[]
  corte                     Corte[]
  producto                  Producto[]

  @@index([productor_id], map: "idx_bodega_productor")
  @@map("bodega")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Campania {
  campania_id                     String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bodega_id                       String                          @db.Uuid
  nombre                          String
  fecha_inicio                    DateTime                        @db.Date
  fecha_fin                       DateTime                        @db.Date
  estado                          String                          @default("abierta")
  created_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  bodega                          Bodega                          @relation(fields: [bodega_id], references: [bodega_id], onDelete: Restrict, onUpdate: NoAction)
  cuartel_campania                CuartelCampania[]
  evento_analisis_suelo           EventoAnalisisDeSuelo[]
  evento_aplicacion_fitosanitaria EventoAplicacionFitosanitaria[]
  evento_canopia                  EventoCanopia[]
  evento_cosecha                  EventoCosecha[]
  evento_energia                  EventoEnergia[]
  evento_fenologia                EventoFenologia[]
  evento_fertilizacion            EventoFertilizacion[]
  evento_labor_suelo              EventoLaborSuelo[]
  evento_monitoreo_enfermedad     EventoMonitoreoEnfermedad[]
  evento_monitoreo_plaga          EventoMonitoreoPlaga[]
  evento_precipitacion            EventoPrecipitacion[]
  evento_riego                    EventoRiego[]
  evento_enmienda                 EventoEnmienda[]
  evento_cobertura_erosion        EventoCoberturaErosion[]
  trazabilidad                    Trazabilidad[]
  corte                           Corte[]

  @@unique([bodega_id, nombre], map: "uq_campania_bodega_nombre")
  @@index([bodega_id], map: "idx_campania_bodega")
  @@map("campania")
}

model CapacitacionAsistente {
  evento_capacitacion_id String             @db.Uuid
  user_id                String             @db.Uuid
  evento_capacitacion    EventoCapacitacion @relation(fields: [evento_capacitacion_id], references: [evento_capacitacion_id], onDelete: Cascade, onUpdate: NoAction)
  app_user               AppUser            @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@id([evento_capacitacion_id, user_id])
  @@map("capacitacion_asistente")
}

model Cuartel {
  cuartel_id                      String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  finca_id                        String                          @db.Uuid
  codigo_cuartel                  String
  superficie_ha                   Decimal?                        @db.Decimal(10, 2)
  cultivo                         String?
  tipo_variedad                   String?
  variedad                        String?
  sistema_riego                   String?
  sistema_productivo              String?
  sistema_conduccion              String?
  cantidad_hileras                Int?
  largo_hileras_m                 Decimal?                        @db.Decimal(10, 2)
  densidad_hileras                Decimal?                        @db.Decimal(10, 2)
  distancia_plantacion            String?
  activo                          Boolean                         @default(true)
  created_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  finca                           Finca                           @relation(fields: [finca_id], references: [finca_id], onUpdate: NoAction)
  cuartel_campania                CuartelCampania[]
  evento_analisis_suelo           EventoAnalisisDeSuelo[]
  evento_aplicacion_fitosanitaria EventoAplicacionFitosanitaria[]
  evento_canopia                  EventoCanopia[]
  evento_cosecha                  EventoCosecha[]
  evento_energia                  EventoEnergia[]
  evento_fenologia                EventoFenologia[]
  evento_fertilizacion            EventoFertilizacion[]
  evento_labor_suelo              EventoLaborSuelo[]
  evento_monitoreo_enfermedad     EventoMonitoreoEnfermedad[]
  evento_monitoreo_plaga          EventoMonitoreoPlaga[]
  evento_riego                    EventoRiego[]
  evento_enmienda                 EventoEnmienda[]
  evento_cobertura_erosion        EventoCoberturaErosion[]
  remito_uva                      RemitoUva[]
  trazabilidad                    Trazabilidad[]
  trazabilidad_origen             TrazabilidadOrigen[]
  tarea                           Tarea[]
  milestone_asignacion            MilestoneAsignacion[]

  @@unique([finca_id, codigo_cuartel])
  @@index([finca_id], map: "idx_cuartel_finca")
  @@map("cuartel")
}

model CuartelCampania {
  cuartel_id  String   @db.Uuid
  campania_id String   @db.Uuid
  estado      String   @default("habilitada")
  campania    Campania @relation(fields: [campania_id], references: [campania_id], onUpdate: NoAction)
  cuartel     Cuartel  @relation(fields: [cuartel_id], references: [cuartel_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([cuartel_id, campania_id])
  @@map("cuartel_campania")
}

model EventoAccidente {
  evento_accidente_id  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha                DateTime @db.Date
  bodega_id            String?  @db.Uuid
  accidentado_user_id  String   @db.Uuid
  tipo                 String?
  accion_correctiva    String?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  bodega               Bodega?  @relation(fields: [bodega_id], references: [bodega_id], onUpdate: NoAction)
  app_user             AppUser  @relation(fields: [accidentado_user_id], references: [user_id], onUpdate: NoAction)

  @@map("evento_accidente")
}

model EventoAnalisisDeSuelo {
  evento_analisis_suelo_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha                    DateTime  @db.Date
  unidad_muestreada        String
  cuartel_id               String?   @db.Uuid
  campania_id              String?   @db.Uuid
  laboratorio              String?
  parametros               Json      @default("{}")
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  campania                 Campania? @relation(fields: [campania_id], references: [campania_id], onUpdate: NoAction)
  cuartel                  Cuartel?  @relation(fields: [cuartel_id], references: [cuartel_id], onUpdate: NoAction)

  @@index([fecha], map: "idx_analisis_suelo_fecha")
  @@map("evento_analisis_suelo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EventoAplicacionFitosanitaria {
  evento_fito_id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha                  DateTime    @db.Date
  cuartel_id             String      @db.Uuid
  campania_id            String      @db.Uuid
  insumo_lote_id         String?     @db.Uuid
  dosis                  Decimal     @db.Decimal(12, 3)
  unidad                 String
  carencia_dias          Int
  motivo                 String?
  responsable_user_id String?     @db.Uuid
  created_at             DateTime    @default(now()) @db.Timestamptz(6)
  campania               Campania    @relation(fields: [campania_id], references: [campania_id], onUpdate: NoAction)
  cuartel                Cuartel     @relation(fields: [cuartel_id], references: [cuartel_id], onUpdate: NoAction)
  insumo_lote            InsumoLote? @relation(fields: [insumo_lote_id], references: [insumo_lote_id], onDelete: Restrict, onUpdate: NoAction)
  app_user               AppUser? @relation(fields: [responsable_user_id], references: [user_id], onUpdate: NoAction)

  @@index([cuartel_id, campania_id, fecha], map: "idx_fito_cuartel_campania_fecha")
  @@map("evento_aplicacion_fitosanitaria")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EventoCanopia {
  evento_canopia_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha                  DateTime @db.Date
  cuartel_id             String   @db.Uuid
  campania_id            String   @db.Uuid
  tipo_practica          String
  intensidad             String?
  jornales               Decimal? @db.Decimal(10, 2)
  responsable_user_id String?  @db.Uuid
  observaciones          String?
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  campania               Campania @relation(fields: [campania_id], references: [campania_id], onUpdate: NoAction)
  cuartel                Cuartel  @relation(fields: [cuartel_id], references: [cuartel_id], onUpdate: NoAction)
  app_user               AppUser? @relation(fields: [responsable_user_id], references: [user_id], onUpdate: NoAction)

  @@index([cuartel_id, campania_id, fecha], map: "idx_canopia_cuartel_campania_fecha")
  @@map("evento_canopia")
}

model EventoCapacitacion {
  evento_capacitacion_id String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha                  DateTime                @db.Date
  bodega_id              String?                 @db.Uuid
  tema                   String
  responsable_user_id String?                 @db.Uuid
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  capacitacion_asistente CapacitacionAsistente[]
  bodega                 Bodega?                 @relation(fields: [bodega_id], references: [bodega_id], onUpdate: NoAction)
  app_user               AppUser? @relation(fields: [responsable_user_id], references: [user_id], onUpdate: NoAction)

  @@map("evento_capacitacion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EventoCosecha {
  lote_cosecha_id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha_cosecha          DateTime          @db.Date
  cuartel_id             String            @db.Uuid
  campania_id            String            @db.Uuid
  cantidad               Decimal           @db.Decimal(12, 3)
  unidad                 String
  destino                String?
  responsable_user_id String?           @db.Uuid
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  campania               Campania          @relation(fields: [campania_id], references: [campania_id], onUpdate: NoAction)
  cuartel                Cuartel           @relation(fields: [cuartel_id], references: [cuartel_id], onUpdate: NoAction)
  app_user               AppUser? @relation(fields: [responsable_user_id], references: [user_id], onUpdate: NoAction)
  remito_uva             RemitoUva[]
  vasija_contenido       VasijaContenido[]
  corte_componente       CorteComponente[]

  @@index([cuartel_id, campania_id, fecha_cosecha], map: "idx_cosecha_cuartel_campania_fecha")
  @@map("evento_cosecha")
}

model RemitoUva {
  remito_uva_id    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bodega_id        String            @db.Uuid
  finca_id         String            @db.Uuid
  cuartel_id       String            @db.Uuid
  lote_cosecha_id  String            @db.Uuid
  salida_finca     DateTime          @db.Timestamptz(6)
  llegada_bodega   DateTime?         @db.Timestamptz(6)
  transportista    String?
  patente          String?
  kg_declarados    Decimal?          @db.Decimal(12, 3)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  bodega           Bodega            @relation(fields: [bodega_id], references: [bodega_id], onDelete: Restrict, onUpdate: NoAction)
  finca            Finca             @relation(fields: [finca_id], references: [finca_id], onDelete: Restrict, onUpdate: NoAction)
  cuartel          Cuartel           @relation(fields: [cuartel_id], references: [cuartel_id], onDelete: Restrict, onUpdate: NoAction)
  evento_cosecha   EventoCosecha     @relation(fields: [lote_cosecha_id], references: [lote_cosecha_id], onDelete: Restrict, onUpdate: NoAction)
  recepcion_bodega RecepcionBodega[]

  @@index([bodega_id, salida_finca], map: "idx_remito_uva_bodega_fecha")
  @@index([finca_id, cuartel_id], map: "idx_remito_uva_origen")
  @@index([lote_cosecha_id], map: "idx_remito_uva_lote")
  @@map("remito_uva")
}

model RecepcionBodega {
  recepcion_bodega_id String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  remito_uva_id       String              @db.Uuid
  fecha_hora          DateTime            @db.Timestamptz(6)
  kg_pesados          Decimal?            @db.Decimal(12, 3)
  clasificacion       String?
  observaciones       String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  remito_uva          RemitoUva           @relation(fields: [remito_uva_id], references: [remito_uva_id], onDelete: Restrict, onUpdate: NoAction)
  analisis_recepcion  AnalisisRecepcion[]
  ciu_recepcion       CiuRecepcion[]
  qc_ingreso_uva      QcIngresoUva[]
  operacion_vasija    OperacionVasija[]

  @@index([remito_uva_id], map: "idx_recepcion_bodega_remito")
  @@index([fecha_hora], map: "idx_recepcion_bodega_fecha")
  @@map("recepcion_bodega")
}

model AnalisisRecepcion {
  analisis_recepcion_id String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recepcion_bodega_id   String          @db.Uuid
  brix                  Decimal?        @db.Decimal(8, 3)
  ph                    Decimal?        @db.Decimal(5, 2)
  acidez                Decimal?        @db.Decimal(8, 3)
  sanidad               String?
  temperatura_uva       Decimal?        @db.Decimal(8, 3)
  observaciones         String?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  recepcion_bodega      RecepcionBodega @relation(fields: [recepcion_bodega_id], references: [recepcion_bodega_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recepcion_bodega_id], map: "idx_analisis_recepcion_recepcion")
  @@map("analisis_recepcion")
}

model Ciu {
  ciu_id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bodega_id     String         @db.Uuid
  codigo_ciu    String
  estado        String         @default("emitido")
  emitido_at    DateTime       @db.Timestamptz(6)
  observaciones String?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  bodega        Bodega         @relation(fields: [bodega_id], references: [bodega_id], onDelete: Restrict, onUpdate: NoAction)
  ciu_recepcion CiuRecepcion[]

  @@unique([codigo_ciu], map: "ciu_codigo_ciu_key")
  @@index([bodega_id, emitido_at], map: "idx_ciu_bodega_emitido_at")
  @@map("ciu")
}

model CiuRecepcion {
  ciu_id              String          @db.Uuid
  recepcion_bodega_id String          @db.Uuid
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  ciu                 Ciu             @relation(fields: [ciu_id], references: [ciu_id], onDelete: Cascade, onUpdate: NoAction)
  recepcion_bodega    RecepcionBodega @relation(fields: [recepcion_bodega_id], references: [recepcion_bodega_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([ciu_id, recepcion_bodega_id])
  @@index([recepcion_bodega_id], map: "idx_ciu_recepcion_recepcion")
  @@map("ciu_recepcion")
}

model QcIngresoUva {
  qc_ingreso_uva_id   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bodega_id           String          @db.Uuid
  recepcion_bodega_id String          @db.Uuid
  fecha_hora          DateTime        @db.Timestamptz(6)
  brix                Decimal?        @db.Decimal(8, 3)
  ph                  Decimal?        @db.Decimal(5, 2)
  acidez              Decimal?        @db.Decimal(8, 3)
  temperatura_uva     Decimal?        @db.Decimal(8, 3)
  estado_pcc          String?
  aprobado            Boolean?
  observaciones       String?
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  bodega              Bodega          @relation(fields: [bodega_id], references: [bodega_id], onDelete: Restrict, onUpdate: NoAction)
  recepcion_bodega    RecepcionBodega @relation(fields: [recepcion_bodega_id], references: [recepcion_bodega_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([bodega_id, fecha_hora], map: "idx_qc_ingreso_uva_bodega_fecha")
  @@index([recepcion_bodega_id], map: "idx_qc_ingreso_uva_recepcion")
  @@map("qc_ingreso_uva")
}

model Vasija {
  vasija_id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bodega_id            String                @db.Uuid
  codigo               String
  tipo                 String?
  capacidad_litros     Decimal?              @db.Decimal(12, 3)
  estado               String?               @default("disponible")
  ubicacion            String?
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  bodega               Bodega                @relation(fields: [bodega_id], references: [bodega_id], onDelete: Restrict, onUpdate: NoAction)
  vasija_contenido     VasijaContenido[]
  existencia_vasija    ExistenciaVasija[]
  control_fermentacion ControlFermentacion[]
  operacion_origen     OperacionVasija[]     @relation("OperacionVasijaOrigen")
  operacion_destino    OperacionVasija[]     @relation("OperacionVasijaDestino")
  corte_componente     CorteComponente[]

  @@unique([bodega_id, codigo], map: "uq_vasija_bodega_codigo")
  @@index([bodega_id], map: "idx_vasija_bodega")
  @@map("vasija")
}

model VasijaContenido {
  vasija_contenido_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vasija_id           String        @db.Uuid
  lote_cosecha_id     String        @db.Uuid
  desde               DateTime      @db.Timestamptz(6)
  hasta               DateTime?     @db.Timestamptz(6)
  kg_aportados        Decimal?      @db.Decimal(12, 3)
  porcentaje_aporte   Decimal?      @db.Decimal(7, 4)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  vasija              Vasija        @relation(fields: [vasija_id], references: [vasija_id], onDelete: Restrict, onUpdate: NoAction)
  evento_cosecha      EventoCosecha @relation(fields: [lote_cosecha_id], references: [lote_cosecha_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([vasija_id, desde], map: "idx_vasija_contenido_vasija_desde")
  @@index([lote_cosecha_id], map: "idx_vasija_contenido_lote")
  @@map("vasija_contenido")
}

model ExistenciaVasija {
  existencia_vasija_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
