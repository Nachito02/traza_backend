  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  milestone     Milestone         @relation(fields: [milestone_id], references: [milestone_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([milestone_id], map: "idx_validacion_milestone")
  @@map("validacion_milestone")
}

enum EvidenciaTipo {
  imagen
  pdf
  planilla
  otro
}

enum MilestoneEstado {
  pendiente
  completado
  validado
  rechazado
}

enum TrazabilidadEstado {
  draft
  en_curso
  finalizada
  certificada
}

enum ValidadoPorTipo {
  sistema
  ia
  tecnico
}

enum SeveridadRegla {
  bloqueo
  alerta
  info
}

enum EstadoHallazgo {
  abierto
  en_proceso
  resuelto
  aceptado
  anulado
}

enum EncargoEstado {
  pendiente
  en_progreso
  completado
  cancelado
}

enum EncargoAsignacionEstado {
  pendiente
  en_progreso
  completado
  cancelado
}

