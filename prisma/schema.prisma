  bot_user             AppUser        @relation("BotDelegationBot", fields: [bot_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  bodega               Bodega?        @relation(fields: [bodega_id], references: [bodega_id], onDelete: SetNull, onUpdate: NoAction)
